<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup rules. The encrypted credentials must never leave the device: their key lives
   in the Android Keystore, which isn't backed up, so a restored copy couldn't be decrypted anyway.
   The saved food QR (files/qr/) is a redemption credential and stays on this device too.
   Reminder settings (app_prefs) are harmless and still back up. The update checker's state
   (app_updates) describes this install only, so it stays behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
        <exclude domain="sharedpref" path="app_updates.xml" />
        <exclude domain="file" path="qr/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
        <exclude domain="sharedpref" path="app_updates.xml" />
        <exclude domain="file" path="qr/" />
    </device-transfer>
</data-extraction-rules>
