# Gradle / build output
.gradle
/build
.kotlin/
.externalNativeBuild
.cxx
/captures

# Local machine config (contains the SDK path)
local.properties

# Android Studio / IntelliJ
*.iml
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml

# Module build output (shared/ has no module-level .gitignore)
/shared/build

# iOS — the Xcode project and Info.plist are generated by XcodeGen from iosApp/project.yml
/iosApp/*.xcodeproj
/iosApp/iosApp/Info.plist
xcuserdata/
DerivedData/

# Signing keys and built artifacts — never commit these
*.jks
*.keystore
*.apk
*.aab
*.ipa
*.mobileprovision
*.p12
/app/release/

# Claude Code per-machine state
.claude/settings.local.json
.claude/*.lock

# OS
.DS_Store
Thumbs.db
